{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "aws-classify mobile expo --project . --cloud-output ../cloud/output.json -- start",
    "android": "aws-classify mobile expo --project . --cloud-output ../cloud/output.json -- start --android",
    "ios": "aws-classify mobile expo --project . --cloud-output ../cloud/output.json -- start --ios",
    "ios:offline": "aws-classify mobile expo --project . --local-api -- start --ios",
    "web": "aws-classify mobile expo --project . --cloud-output ../cloud/output.json -- start --web",
    "export": "aws-classify mobile expo --project . --cloud-output ../cloud/output.json -- export",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "@simple-chat/requests": "0.1.0",
    "aws-classify-client": "^0.2.2",
    "aws-classify-common": "^0.2.2",
    "expo": "^58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "proxily": "^1.1.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/react": "~19.2.0",
    "expo-doctor": "^1.21.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
