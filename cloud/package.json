{
  "name": "aws-classify-example-simple-chat",
  "version": "1.0.0",
  "description": "Chat sample app for aws-classify",
  "main": "index.js",
  "scripts": {
    "build:static": "npm --workspace web run build",
    "typecheck": "tsc --noEmit",
    "db:start": "dynalite --host 127.0.0.1 --port 4567",
    "db:init": "aws-classify cloud db:init --config serverless.yml",
    "offline": "aws-classify cloud offline --config serverless.yml --backend-only",
    "offline:debug": "aws-classify cloud offline --config serverless.yml --backend-only --debug",
    "dev": "aws-classify cloud offline --config serverless.yml --web ../web",
    "dev:debug": "aws-classify cloud offline --config serverless.yml --web ../web --debug",
    "deploy:dev": "npm run build:static && aws-classify cloud deploy --config serverless.yml --stage dev --publish --source ../web/dist",
    "deploy:prod": "npm run build:static && aws-classify cloud deploy --config serverless.yml --stage prod --publish --source ../web/dist",
    "remove:dev": "aws-classify cloud remove --config serverless.yml --stage dev"
  },
  "author": "Sam Elsamman",
  "license": "ISC",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.103",
    "@types/node": "^22.0.0",
    "aws-classify-tools": "^0.2.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@simple-chat/requests": "0.1.0",
    "aws-classify-common": "^0.2.2",
    "aws-classify-server": "^0.2.2"
  }
}
